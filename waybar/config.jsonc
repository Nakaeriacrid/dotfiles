{
  "layer": "top",
  "position": "top",
  "margin-top": 2,
  "margin-bottom": 4,
  "margin-right": 6,
  "margin-left": 6,
  "autohide": true,
  "autohide-blocked": false,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "modules-left": [
    "clock",
    "group/hardware"
  ],
  "modules-center": [],
  "modules-right": [
    "group/musica"
  ],

  "clock": {
    "locale": "C",
    "format": "{:%H:%M  %d/%m}",
    "tooltip-format": "{calendar}",
    "calendar": {
      "mode": "month",
      "iso8601": "true"
    }
  },
  "cpu": {
    "interval": 5,
    "format": "CPU: [{usage}% {avg_frequency}GHz]",
    "tooltip": false
  },
  "memory": {
    "format": "Memória: [{used} GB/{total} GB]",
    "tooltip": false
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip": false,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    },
    "pulseaudio/slider": {
      "format": "{volume}%",
      "format-muted": " MUTE",
      "step": 1,
      "max": 100,
      "min": 0,
      "tooltip": false
    }
  },
  "mpris": {
    "interval": 1,
    "format": "{artist}//{title} - {album} {player_icon} ",
    "format-paused": "{status_icon} {title} - {album}",
    "title-len": 40,
    "tooltip-format": "Artista: {artist} - Musica: {title} {position}//{length}",
    "player-icons": {
      "default": "▶",
      "mpv": "🎵"
    },
    "status-icons": {
      "paused": "⏸"
    }
  },
  "group/musica": {
    "children-class": "slider",
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 200,
      "transition-left-to-right": false
    },
    "modules": [
      "mpris",
      "pulseaudio/slider"
    ]
  },
  "group/hardware": {
    "children-class": "mtp",
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 200,
      "transition-left-to-right": true
    },
    "modules": [
      "cpu",
      "memory",
      "power-profiles-daemon"
    ]
  }
}
