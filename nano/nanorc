
## Hide the bars plus help lines and use the whole terminal as edit area.
 set zero


## Paint the interface elements of nano.  These are examples; there are
## no colors by default, except for errorcolor and spotlightcolor.
 set promptcolor black,lightwhite
 set statuscolor black,lightwhite
 set errorcolor white,red
 set spotlightcolor black,white
 set selectedcolor #FFF,#F00
 set stripecolor ,#444
 set scrollercolor slate,#222
 set numbercolor #1AE
 set keycolor cyan
 set functioncolor green

